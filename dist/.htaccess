# Apache deployment only. Existing Node.js hosting must be configured separately.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.ziyorattour\.uz$ [NC]
RewriteRule ^ https://ziyorattour.uz%{REQUEST_URI} [R=301,L,NE]
RewriteRule ^uz/?$ / [R=301,L]
RewriteRule ^blog-1/ru/?$ /ru/umra-standart/ [R=301,L]
RewriteRule ^blog-1/uz/?$ /uz/umra-standart/ [R=301,L]
RewriteRule ^blog-2/ru/?$ /ru/umra-komfort/ [R=301,L]
RewriteRule ^blog-2/uz/?$ /uz/umra-komfort/ [R=301,L]
RewriteRule ^blog-3/ru/?$ /ru/umra-vip/ [R=301,L]
RewriteRule ^blog-3/uz/?$ /uz/umra-vip/ [R=301,L]
<IfModule mod_headers.c>
<FilesMatch "\.(webp|jpg|png|css|js)$">
Header set Cache-Control "public, max-age=86400"
</FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/ld+json application/xml text/plain
</IfModule>
